await (async (page) => {
  await page.setViewportSize({width:1280,height:720});
  const cdp = await page.context().newCDPSession(page);
  await cdp.send('Network.enable');
  await cdp.send('Network.clearBrowserCache');
  await cdp.send('Network.setCacheDisabled',{cacheDisabled:true});
  const resp=[], fails=[], errs=[], cons=[];
  const onR = r => resp.push({u:r.url().replace('http://localhost:8000',''), s:r.status(), ct:r.headers()['content-type'], sw:r.fromServiceWorker()});
  const onF = r => fails.push({u:r.url(), e:r.failure()&&r.failure().errorText});
  const onE = e => errs.push(String(e));
  const onC = m => cons.push(m.type()+': '+m.text());
  page.on('response',onR); page.on('requestfailed',onF); page.on('pageerror',onE); page.on('console',onC);
  const t0=Date.now();
  await page.goto('http://localhost:8000/', {waitUntil:'domcontentloaded'});
  const samples=[];
  const probe = () => page.evaluate(() => {
    const c=document.getElementById('canvas'); const M=window.Module||{};
    let ready=null,tic=null; try{ready=M._cap_ready?M._cap_ready():null; tic=M._cap_tic_count?M._cap_tic_count():null;}catch(e){}
    let px=null;
    try{ const o=document.createElement('canvas'); o.width=c.width;o.height=c.height; const x=o.getContext('2d'); x.drawImage(c,0,0); const d=x.getImageData(0,0,o.width,o.height).data; let n=0,tr=0,r=0,g=0,b=0; for(let i=0;i<d.length;i+=4*97){n++; if(d[i+3]===0)tr++; r+=d[i];g+=d[i+1];b+=d[i+2];} px={n,tr,r:Math.round(r/n),g:Math.round(g/n),b:Math.round(b/n)}; }catch(e){px=String(e)}
    return {w:c.width,h:c.height,ready,tic,px,title:document.title};
  });
  while(Date.now()-t0<3500){ samples.push({t:Date.now()-t0, ...(await probe())}); await page.waitForTimeout(100); }
  await page.screenshot({path:'artifacts/logs/reviewer_site.0fZGKo/title-early.png'});
  page.off('response',onR); page.off('requestfailed',onF); page.off('pageerror',onE); page.off('console',onC);
  const out={resp,fails,errs,consCount:cons.length,cons,samples};
  require = undefined;
  return JSON.stringify(out);
})(page);
