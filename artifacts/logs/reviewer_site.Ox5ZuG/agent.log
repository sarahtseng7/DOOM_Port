await (async (page) => {
  const cdp = await page.context().newCDPSession(page);
  await cdp.send('Network.enable'); await cdp.send('Network.clearBrowserCache'); await cdp.send('Network.setCacheDisabled', {cacheDisabled: true});
  const resp = [], failed = [], perrs = [], cons = [];
  page.on('response', r => resp.push({url: r.url().replace('http://localhost:8000',''), status: r.status(), sw: r.fromServiceWorker()}));
  page.on('requestfailed', r => failed.push(r.url()));
  page.on('pageerror', e => perrs.push(String(e)));
  page.on('console', m => cons.push(m.type()+': '+m.text().slice(0,160)));
  const t0 = Date.now();
  await page.goto('http://localhost:8000/?fresh=' + t0);
  const samples = [];
  for (const t of [100, 500, 1000, 2000, 3000]) {
    while (Date.now() - t0 < t) await page.waitForTimeout(10);
    samples.push(await page.evaluate(() => {
      const M = window.Module; const c = document.querySelector('canvas');
      let ready = null, tic = null; try { ready = M._cap_ready(); tic = M._cap_tic_count(); } catch (e) {}
      let px = null;
      try { const g = document.createElement('canvas'); g.width = 64; g.height = 40; const x = g.getContext('2d'); x.drawImage(c, 0, 0, 64, 40);
        const d = x.getImageData(0,0,64,40).data; let r=0,gg=0,b=0,tr=0; for (let i=0;i<d.length;i+=4){r+=d[i];gg+=d[i+1];b+=d[i+2]; if(d[i+3]===0)tr++;}
        const n=d.length/4; px = {mean:[Math.round(r/n),Math.round(gg/n),Math.round(b/n)], transparent: tr, n}; } catch(e) { px = String(e); }
      return {ms: Math.round(performance.now()), ready, tic, w: c && c.width, h: c && c.height, px, title: document.title};
    }));
  }
  await cdp.send('Network.setCacheDisabled', {cacheDisabled: false});
  return {samples, resp, failed, perrs, cons};
})(page);
