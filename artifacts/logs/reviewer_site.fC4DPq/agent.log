await (async (page) => {
  await page.setViewportSize({width:1280, height:720});
  const cdp = await page.context().newCDPSession(page);
  await cdp.send('Network.enable');
  await cdp.send('Network.clearBrowserCache');
  await cdp.send('Network.setCacheDisabled', {cacheDisabled: true});
  const resp = [], fails = [], errs = [], cons = [];
  page.on('response', r => resp.push(`${r.status()} ${r.url().replace('http://localhost:8000','')} sw=${r.fromServiceWorker()}`));
  page.on('requestfailed', r => fails.push(r.url()+' '+(r.failure()||{}).errorText));
  page.on('pageerror', e => errs.push(String(e)));
  page.on('console', m => cons.push(`${m.type()}: ${m.text()}`));
  const t0 = Date.now();
  await page.goto('http://localhost:8000/', {waitUntil:'commit'});
  const samples = [];
  for (let i=0;i<30;i++){
    samples.push(await page.evaluate(() => {
      const c = document.querySelector('canvas'); let info = {title: document.title};
      if (c) { info.cw=c.width; info.ch=c.height;
        try { const t=document.createElement('canvas'); t.width=c.width; t.height=c.height; const x=t.getContext('2d'); x.drawImage(c,0,0);
          const d=x.getImageData(0,0,c.width,c.height).data; let r=0,g=0,b=0,tr=0,n=d.length/4;
          for(let i=0;i<d.length;i+=4){r+=d[i];g+=d[i+1];b+=d[i+2]; if(d[i+3]===0)tr++;}
          info.mean=[r/n|0,g/n|0,b/n|0]; info.transparent=tr; } catch(e){info.err=String(e);} }
      const M=window.Module; info.tic = (M && M._cap_tic_count) ? M._cap_tic_count() : null;
      info.ready = (M && M._cap_ready) ? M._cap_ready() : null;
      return info; }).then(v => ({ms: Date.now()-t0, ...v})).catch(e=>({ms:Date.now()-t0, err:String(e)})));
    await page.waitForTimeout(80);
  }
  await page.screenshot({path:'artifacts/logs/reviewer_site.fC4DPq/title-early.png'});
  return JSON.stringify({samples, resp, fails, errs, consCount: cons.length, consNonLog: cons.filter(c=>!c.startsWith('log:')), consHead: cons.slice(0,25)}, null, 1);
})(page);
