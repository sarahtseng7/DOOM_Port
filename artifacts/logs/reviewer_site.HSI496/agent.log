  page.on('response', r=>resps.push({url:r.url().replace('http://localhost:8000',''),status:r.status(),sw:r.fromServiceWorker(),ct:r.headers()['content-type']}));
  page.on('requestfailed', r=>fails.push(r.url()+' '+(r.failure()&&r.failure().errorText)));
  page.on('pageerror', e=>errs.push(String(e)));
  page.on('console', m=>cons.push(m.type()+': '+m.text()));
  await page.addInitScript(()=>{
    window.__samples=[]; const t0=performance.now();
    const probe=()=>{ const c=document.getElementById('canvas'); let s={t:Math.round(performance.now()-t0)};
      try{ const M=window.Module; s.ready=M&&M._cap_ready?M._cap_ready():null; s.tic=M&&M._cap_tic_count?M._cap_tic_count():null;}catch(e){s.err=String(e)}
      if(c){ try{ const o=document.createElement('canvas'); o.width=c.width;o.height=c.height; const x=o.getContext('2d'); x.drawImage(c,0,0); const d=x.getImageData(0,0,c.width,c.height).data; let tr=0,r=0,g=0,b=0,n=0; for(let i=0;i<d.length;i+=4*97){ if(d[i+3]===0)tr++; r+=d[i];g+=d[i+1];b+=d[i+2];n++;} s.transp=tr; s.mean=[r/n|0,g/n|0,b/n|0];}catch(e){s.canvasErr=String(e)} }
      s.title=document.title; window.__samples.push(s); if(performance.now()-t0<3200) setTimeout(probe,95); };
    document.addEventListener('DOMContentLoaded',probe);
  });
  await page.goto('http://localhost:8000/', {waitUntil:'load'});
  await page.waitForTimeout(3500);
  await page.screenshot({path:'artifacts/logs/reviewer_site.HSI496/title-early.png'});
  const samples = await page.evaluate(()=>window.__samples);
  await cdp.send('Network.setCacheDisabled',{cacheDisabled:false});
  return JSON.stringify({samples,resps,fails,errs,cons});
})(page);
