  const cdp = await page.context().newCDPSession(page);
  await cdp.send('Network.enable'); await cdp.send('Network.clearBrowserCache'); await cdp.send('Network.setCacheDisabled',{cacheDisabled:true});
  const errs=[], cons=[], fails=[], resp=[];
  page.on('pageerror', e=>errs.push(String(e)));
  page.on('console', m=>cons.push(m.type()+': '+m.text()));
  page.on('requestfailed', r=>fails.push(r.url()));
  page.on('response', r=>resp.push(r.status()+' '+r.url()));
  const t0=Date.now();
  await page.goto('http://localhost:8000/', {waitUntil:'commit'});
  const samples=[];
  for (let i=0;i<50;i++){
    const s = await page.evaluate(()=>{
      const c=document.querySelector('canvas'); let info={};
      if(c){ const o=document.createElement('canvas'); o.width=64;o.height=40; const x=o.getContext('2d'); x.drawImage(c,0,0,64,40); const d=x.getImageData(0,0,64,40).data; let tr=0,r=0,g=0,b=0; const set=new Set(); for(let i=0;i<d.length;i+=4){ if(d[i+3]===0)tr++; r+=d[i];g+=d[i+1];b+=d[i+2]; set.add((d[i]>>4)+','+(d[i+1]>>4)+','+(d[i+2]>>4)); } const n=d.length/4; info={w:c.width,h:c.height,tr,buckets:set.size,mean:[r/n|0,g/n|0,b/n|0]}; }
      let tic=null; try{ tic = window.Module && Module._cap_tic_count ? Module._cap_tic_count() : null }catch(e){}
      return {tic,title:document.title,...info};
    }).catch(e=>({err:String(e)}));
    samples.push({ms:Date.now()-t0,...s});
    await page.waitForTimeout(100);
  }
  const geom = await page.evaluate(()=>{const r=document.querySelector('canvas').getBoundingClientRect(); return {x:r.x,y:r.y,w:r.width,h:r.height,sw:document.documentElement.scrollWidth,sh:document.documentElement.scrollHeight}});
  await page.screenshot({path:'artifacts/logs/reviewer_site.qchn1m/startup.png'});
  const first = samples.find(s=>s.tr===0 && s.buckets>20);
  const last = samples[samples.length-1];
  return JSON.stringify({first, last, ticRate: first&&last.tic!=null ? (last.tic-first.tic)/((last.ms-first.ms)/1000):null, geom, errs, fails, resp, cons, samples});
})(page);
