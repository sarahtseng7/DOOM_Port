await (async (page) => {
  const cdp = await page.context().newCDPSession(page);
  await cdp.send('Network.enable'); await cdp.send('Network.clearBrowserCache'); await cdp.send('Network.setCacheDisabled', {cacheDisabled: true});
  const reqs = [], fails = [], errs = [];
  page.on('response', r => reqs.push([r.url().replace('http://localhost:8000',''), r.status(), r.fromServiceWorker()]));
  page.on('requestfailed', r => fails.push(r.url()));
  page.on('pageerror', e => errs.push(String(e)));
  const t0 = Date.now();
  await page.goto('http://localhost:8000/?r=' + t0);
  const samples = []; let firstFrame = null;
  for (let i = 0; i < 40; i++) {
    const s = await page.evaluate(() => {
      const c = document.querySelector('canvas'); if (!c) return {canvas:false};
      let colours = -1, opaqueBad = -1;
      try { const g = c.getContext('2d'); if (g) { const d = g.getImageData(0,0,c.width,c.height).data; const set = new Set(); opaqueBad=0;
        for (let k=0;k<d.length;k+=4*97){ set.add((d[k]<<16)|(d[k+1]<<8)|d[k+2]); if (d[k+3]!==255) opaqueBad++; } colours=set.size; } } catch(e) { colours = 'err:'+e.message; }
      const M = window.Module; const tics = M && M._cap_tic_count ? M._cap_tic_count() : null;
      return {canvas:true, w:c.width, h:c.height, cw:c.clientWidth, ch:c.clientHeight, colours, opaqueBad, tics, ready: M && M._cap_ready ? M._cap_ready() : null, title: document.title};
    });
    s.t = Date.now() - t0; samples.push(s);
    if (firstFrame === null && typeof s.colours === 'number' && s.colours > 8) firstFrame = s.t;
    await page.waitForTimeout(100);
  }
  return JSON.stringify({firstFrame, reqs, fails, errs, first: samples.slice(0,6), last: samples.slice(-3), ticSeries: samples.filter((_,i)=>i%5==0).map(s=>[s.t,s.tics])});
})(page);
