# Acceptance entry point (tester-owned). Exit 0 only if build + every required check passes.
# Env: RUN_ID (evidence dir name), SOAK_SECONDS (default 300), QUICK=1 (partial; never exits 0),
#      SKIP_BUILD=1 is intentionally NOT supported.
set -u
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
RUN_ID="${RUN_ID:-manual-$(date -u +%Y%m%dT%H%M%SZ)}"
OUT_DIR="${OUT_DIR:-artifacts/runs/$RUN_ID/tester/verify-$(date -u +%H%M%SZ)}"
mkdir -p "$OUT_DIR"
OUT_DIR="$(cd "$OUT_DIR" && pwd)"
export OUT_DIR
fail() { echo "VERIFY FAIL: $1" | tee -a "$OUT_DIR/verify.log"; exit "${2:-1}"; }
step() { echo "== $1" | tee -a "$OUT_DIR/verify.log"; }

# Identity of what was tested.
{
  echo "commit: $(git rev-parse HEAD)"
  echo "dirty_diff_sha256: $(git diff HEAD -- . ':!artifacts' | shasum -a 256 | cut -d' ' -f1)"
  git status --short -- . ':!artifacts' | sed 's/^/status: /'
  echo "tests_sha256: $(cat tests/verify.sh tests/faults.sh tests/playtest.mjs tests/selftest.mjs tests/lib/frames.mjs tests/package.json | shasum -a 256 | cut -d' ' -f1)"
  echo "wad_sha256: $(shasum -a 256 assets/doom1.wad | cut -d' ' -f1)"
  echo "emcc: $(emcc --version 2>/dev/null | head -1 || echo missing)"
} > "$OUT_DIR/identity.txt"

step "tooling"
command -v node >/dev/null || fail "node missing" 2
command -v make >/dev/null || fail "make missing" 2
command -v emcc >/dev/null || fail "emcc missing (source emsdk 4.0.18 env)" 2
(cd tests && npm ci --no-audit --no-fund >>"$OUT_DIR/verify.log" 2>&1) || fail "npm ci in tests/ failed" 2
(cd tests && npx playwright install chromium >>"$OUT_DIR/verify.log" 2>&1) || fail "playwright chromium install failed" 2

step "helper self-test (fault injection on pixel checks)"
node tests/selftest.mjs 2>&1 | tee "$OUT_DIR/selftest.log"; [ "${PIPESTATUS[0]}" -eq 0 ] || fail "selftest failed"

step "clean build"
{ make clean && make all; } >"$OUT_DIR/build.log" 2>&1 || fail "make clean && make all failed (see $OUT_DIR/build.log)"
[ -f dist/index.html ] && [ -f dist/doom.wasm ] || fail "dist/index.html or dist/doom.wasm missing after build"
shasum -a 256 dist/* > "$OUT_DIR/dist-sha256.txt" 2>/dev/null

step "browser playtest"
node tests/playtest.mjs 2>&1 | tee "$OUT_DIR/playtest.log"
rc=${PIPESTATUS[0]}
if [ "$rc" -eq 0 ] && [ "${QUICK:-0}" != 1 ]; then
  step "fault injection (checks must fail on broken behaviour)"
  tests/faults.sh 2>&1 | tee "$OUT_DIR/faults.log"; [ "${PIPESTATUS[0]}" -eq 0 ] || rc=1
fi
echo "{\"exit\": $rc, \"evidence\": \"$OUT_DIR\"}" > "$OUT_DIR/verify-result.json"
exit "$rc"
#!/usr/bin/env bash
# Fault-injection runs (tester-owned): each FAULT must make playtest.mjs exit 1 with one of the expected
# check IDs FAILing. Proves the checks catch these faults; says nothing about faults not listed.
# Usage: tests/faults.sh  (needs dist/ built). Env: OUT_DIR (evidence root), SOAK_SECONDS (default 5).
set -u
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"; cd "$ROOT"
BASE="${OUT_DIR:-artifacts/runs/manual-$(date -u +%Y%m%dT%H%M%SZ)/tester/faults}"; mkdir -p "$BASE"
BASE="$(cd "$BASE" && pwd)"
declare -a CASES=("drop-keyup:I2 I5 I6 C3 I7" "drop-blur:I7" "ignore-left:I3 E2a E2b" "swap-rb:B4 B6")
rc=0
for c in "${CASES[@]}"; do
  f="${c%%:*}"; ids="${c#*:}"
  FAULT="$f" OUT_DIR="$BASE/$f" SOAK_SECONDS="${SOAK_SECONDS:-5}" node tests/playtest.mjs >"$BASE/$f.log" 2>&1; code=$?
  hit=""; for id in $ids; do grep -q "^FAIL *$id" "$BASE/$f.log" && hit="$hit $id"; done
  if [ "$code" -eq 1 ] && [ -n "$hit" ]; then echo "caught  FAULT=$f (failed:$hit)"
  else echo "MISSED  FAULT=$f exit=$code expected one of: $ids (see $BASE/$f.log)"; rc=1; fi
done
exit $rc
// Pixel analysis helpers for canvas screenshots (pngjs PNG objects: {width,height,data RGBA}).
// Regions are fractions {x0,y0,x1,y1} of the image so canvas CSS scaling does not matter.
export const VIEW = { x0: 0, y0: 0, x1: 1, y1: 0.80 };      // 3D view (status bar is bottom 32/200)
export const STATUSBAR = { x0: 0, y0: 0.84, x1: 1, y1: 1 };
export const AMMO = { x0: 0.0, y0: 0.86, x1: 0.20, y1: 0.99 }; // ammo counter at status bar left
export const FULL = { x0: 0, y0: 0, x1: 1, y1: 1 };

function box(p, r) {
  return [Math.floor(r.x0 * p.width), Math.floor(r.y0 * p.height),
          Math.ceil(r.x1 * p.width), Math.ceil(r.y1 * p.height)];
}

export function stats(p, r = FULL) {
  const [x0, y0, x1, y1] = box(p, r);
  const colors = new Set();
  let n = 0, R = 0, G = 0, B = 0, dark = 0, transparent = 0;
  for (let y = y0; y < y1; y++) for (let x = x0; x < x1; x++) {
    const i = (y * p.width + x) * 4;
    const [r_, g, b, a] = [p.data[i], p.data[i + 1], p.data[i + 2], p.data[i + 3]];
    n++; R += r_; G += g; B += b;
    if (a < 255) transparent++;
    if (r_ + g + b < 48) dark++;
    colors.add((r_ << 16) | (g << 8) | b);
  }
  return { n, meanR: R / n, meanG: G / n, meanB: B / n, darkFrac: dark / n,
           distinctColors: colors.size, transparentFrac: transparent / n };
}

// Fraction of pixels whose max channel delta exceeds `thr`.
export function diffFrac(a, b, r = FULL, thr = 24) {
  if (a.width !== b.width || a.height !== b.height) throw new Error('size mismatch');
  const [x0, y0, x1, y1] = box(a, r);
  let c = 0, n = 0;
  for (let y = y0; y < y1; y++) for (let x = x0; x < x1; x++) {
    const i = (y * a.width + x) * 4; n++;
    const d = Math.max(Math.abs(a.data[i] - b.data[i]), Math.abs(a.data[i + 1] - b.data[i + 1]),
                       Math.abs(a.data[i + 2] - b.data[i + 2]));
    if (d > thr) c++;
  }
  return c / n;
}

function colProfile(p, r) {
  const [x0, y0, x1, y1] = box(p, r); const prof = new Float64Array(x1 - x0);
  for (let x = x0; x < x1; x++) { let s = 0;
    for (let y = y0; y < y1; y++) { const i = (y * p.width + x) * 4; s += p.data[i] * .3 + p.data[i + 1] * .59 + p.data[i + 2] * .11; }
    prof[x - x0] = s / (y1 - y0); }
  return prof;
}

// Horizontal shift (pixels, positive = content of b moved right relative to a) minimizing
// mean abs column-profile error over +-maxShift. Turning right => negative shift.
// Returns {shift, err, err0}: err0 is the error at zero shift (to confirm real improvement).
export function bestShift(a, b, r = VIEW, maxShift = Math.floor(a.width / 3)) {
  const pa = colProfile(a, r), pb = colProfile(b, r); const w = pa.length; const m = Math.floor(w * 0.15);
  const errAt = (s) => { let e = 0, c = 0;
    for (let x = m; x < w - m; x++) { const xb = x + s; if (xb < 0 || xb >= w) continue; e += Math.abs(pa[x] - pb[xb]); c++; }
    return c ? e / c : Infinity; };
  let best = 0, be = Infinity;
  for (let s = -maxShift; s <= maxShift; s++) { const e = errAt(s); if (e < be) { be = e; best = s; } }
  return { shift: best, err: be, err0: errAt(0) };
}
// Fault-injection self-test for the analysis helpers: proves the pixel checks FAIL on bad frames.
// Needs no browser or build. Run: node tests/selftest.mjs
import { PNG } from 'pngjs';
import { stats, diffFrac, bestShift, VIEW } from './lib/frames.mjs';
let fails = 0;
const ok = (name, cond) => { console.log(`${cond ? 'ok  ' : 'FAIL'} ${name}`); if (!cond) fails++; };
function img(fn, w = 320, h = 200) { const p = new PNG({ width: w, height: h });
  for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) { const [r, g, b, a = 255] = fn(x, y); const i = (y * w + x) * 4;
    p.data[i] = r; p.data[i + 1] = g; p.data[i + 2] = b; p.data[i + 3] = a; } return p; }
const scene = (off) => img((x, y) => { const v = ((x + off) * 7 % 200) + 30; return [v, v * .6, v * .3]; });
const base = scene(0);
ok('good frame: colourful, warm, opaque', (s => s.distinctColors > 16 && s.meanR > s.meanB && s.transparentFrac === 0)(stats(base)));
ok('black frame detected', stats(img(() => [0, 0, 0])).darkFrac > 0.99);
ok('R/B channel swap detected', (s => s.meanB > s.meanR)(stats(img((x, y) => { const v = ((x * 7) % 200) + 30; return [v * .3, v * .6, v]; }))));
ok('alpha=0 (unfixed BGR0) detected', stats(img(() => [90, 60, 30, 0])).transparentFrac === 1);
ok('identical frames: diff 0', diffFrac(base, scene(0)) === 0);
ok('different frames: diff large', diffFrac(base, scene(37)) > 0.2);
const r = bestShift(base, scene(-12)); // content moved right by 12 (x+off sampled at x-12)
ok('shift sign/size: right-moved content => +12', r.shift === 12 && r.err < r.err0);
ok('shift sign: left-moved => -12', bestShift(base, scene(12)).shift === -12);
ok('static frames: no spurious shift improvement', (q => q.shift === 0)(bestShift(base, scene(0))));
// Regression for reviewer R2-1: a shift beyond the search window aliases; the 150ms-hold shift must be well inside it.
const big = bestShift(base, scene(-240)); ok('shift beyond +-213px window is NOT reported as 240 (documents aliasing)', big.shift !== 240);
ok('150ms-class shift (~90px) measured exactly', bestShift(base, scene(-90)).shift === 90);
process.exit(fails ? 1 : 0);
