// Rendering and timing for the WebAssembly port (coder_render_timing-owned).
// Strong definitions of the cap_render_* / cap_time_ms / cap_sleep_ms /
// cap_set_title hooks; they override the weak defaults in cap_fallback.c.
// Contract: platform/capstone_bridge.h (version 3).

#include <stdint.h>

#include <emscripten.h>

#include "capstone_bridge.h"
#include "render_timing.h"

// Engine framebuffer bytes are B,G,R,0; canvas ImageData wants R,G,B,A.
// On little-endian wasm the source word is 0x00RRGGBB and the output word
// must be 0xAABBGGRR with A forced to 255.
static uint32_t rgba[CAP_FB_WIDTH * CAP_FB_HEIGHT];

static uint32_t frames_presented;

EM_JS(int, rt_js_init, (int w, int h), {
    var c = Module.canvas || document.getElementById('canvas');
    if (!c) return 0;
    // alpha:false lets the browser skip compositing against the page.
    var ctx = c.getContext('2d', { alpha: false });
    if (!ctx) return 0;
    ctx.imageSmoothingEnabled = false;
    Module._rt = { ctx: ctx, w: w, h: h, frames: 0, lastPresent: 0 };
    // Observable by tests: Module._rt.frames increments once per DG_DrawFrame.
    return 1;
});

EM_JS(void, rt_js_put, (const void *px, int w, int h), {
    var rt = Module._rt;
    if (!rt) return;
    // Reuse the ImageData while the heap buffer and pointer are unchanged;
    // ALLOW_MEMORY_GROWTH replaces HEAPU8.buffer, which invalidates the view.
    if (!rt.img || rt.buf !== HEAPU8.buffer || rt.px !== px) {
        rt.buf = HEAPU8.buffer;
        rt.px = px;
        rt.img = new ImageData(new Uint8ClampedArray(rt.buf, px, w * h * 4), w, h);
    }
    rt.ctx.putImageData(rt.img, 0, 0);
    rt.frames++;
    rt.lastPresent = performance.now();
});

EM_JS(void, rt_js_title, (const char *t), { document.title = UTF8ToString(t); });

void cap_render_init(void)
{
    frames_presented = 0;
    rt_js_init(CAP_FB_WIDTH, CAP_FB_HEIGHT);
}

void cap_render_present(const pixel_t *fb)
{
    const uint32_t *src = (const uint32_t *)fb;
    for (int i = 0; i < CAP_FB_WIDTH * CAP_FB_HEIGHT; i++) {
        uint32_t s = src[i];
        rgba[i] = 0xFF000000u | ((s & 0xFFu) << 16) | (s & 0xFF00u) | ((s >> 16) & 0xFFu);
    }
    rt_js_put(rgba, CAP_FB_WIDTH, CAP_FB_HEIGHT);
    frames_presented++;
}

uint32_t cap_time_ms(void)
{
    // Milliseconds since page start (monotonic). +1 keeps the first call
    // nonzero: i_timer.c treats basetime==0 as unset.
    return (uint32_t)emscripten_get_now() + 1;
}

// The engine only sleeps in 1 ms polls (wipe loop in d_main.c, tic wait in
// d_loop.c) and a 100 ms retry in d_loop.c. With ASYNCIFY, emscripten_sleep
// returns control to the event loop via setTimeout, so input, rAF and
// painting keep running while the engine waits and real time advances.
void cap_sleep_ms(uint32_t ms)
{
    emscripten_sleep(ms);
}

void cap_set_title(const char *title)
{
    rt_js_title(title);
}

uint32_t cap_render_frames(void)
{
    return frames_presented;
}
// Private header for platform/render_timing.c (coder_render_timing-owned).
// The cross-module hooks are declared in capstone_bridge.h; only extras here.
#ifndef RENDER_TIMING_H
#define RENDER_TIMING_H

#include <stdint.h>

// Number of frames passed to cap_render_present since cap_render_init.
uint32_t cap_render_frames(void);

#endif // RENDER_TIMING_H
// Display scaling for the Doom canvas (coder_render_timing-owned).
// Pixel conversion and timing live in platform/render_timing.c; this file only
// changes the canvas CSS size so the fixed 640x400 backing store fills the
// window at its 16:10 aspect. It never touches the canvas width/height, so
// frame contents and the 640x400 framebuffer contract are unchanged.
(function () {
  var W = 640, H = 400;
  function fit() {
    var c = document.getElementById('canvas');
    if (!c) return;
    // Work in device pixels so HiDPI displays also get whole-pixel scaling.
    var dpr = window.devicePixelRatio || 1;
    var s = Math.min(window.innerWidth / W, window.innerHeight / H) * dpr;
    // Prefer an integer scale (crisp pixel-doubled art) only when it uses most
    // of the window; otherwise fill at the fractional fit (e.g. 1280x720 would
    // floor 1.8x to 1x and leave large borders).
    var si = Math.floor(s);
    if (si >= 1 && si >= s * 0.9) s = si;
    c.style.width = Math.floor(W * s) / dpr + 'px';
    c.style.height = Math.floor(H * s) / dpr + 'px';
  }
  window.addEventListener('resize', fit);
  window.addEventListener('DOMContentLoaded', fit);
  fit();
})();
# Doom -> WebAssembly build. Requires Emscripten 4.0.18 (source emsdk_env.sh
# or use the Dockerfile image). Output: dist/{index.html,doom.js,doom.wasm,doom.data}
EMCC      ?= emcc
ENGINE    := third_party/doomgeneric
BUILD     := build
DIST      := dist
WAD       := assets/doom1.wad

# Platform-specific/unused engine files: dummy.c, i_cdmus.c, i_joystick.c are
# stubs here; net_* sources are absent from this tree.
ENGINE_EXCLUDE := $(ENGINE)/dummy.c $(ENGINE)/doomgeneric_sdl.c
ENGINE_SRC := $(filter-out $(ENGINE_EXCLUDE),$(wildcard $(ENGINE)/*.c))
PLAT_SRC   := $(wildcard platform/*.c)
OBJS       := $(patsubst %.c,$(BUILD)/%.o,$(ENGINE_SRC) $(PLAT_SRC))

CFLAGS  := -O2 -I$(ENGINE) -Iplatform -Iplatform/audio_compat -DFEATURE_SOUND -MMD -MP
ENGINE_CFLAGS := -w   # silence warnings for the supplied engine only
LDFLAGS := -O2 -sASYNCIFY -sASYNCIFY_STACK_SIZE=65536 -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=64MB \
           -sEXPORTED_FUNCTIONS=_main,_cap_ready,_cap_tic_count,_cap_input_event,_cap_input_reset,_cap_bridge_version,_cap_framebuffer_ptr,_cap_input_impl,_cap_input_delivered_count,_cap_input_dropped_count,_cap_player_valid,_cap_player_x,_cap_player_y,_cap_player_angle,_cap_player_health,_cap_level_id,_cap_sector_count,_cap_sector_floor,_cap_sector_ceiling,_cap_player_sector \
           -sEXPORTED_RUNTIME_METHODS=ccall,cwrap,HEAPU8 \
           --preload-file $(WAD)@/doom1.wad

.PHONY: all clean
all: $(DIST)/index.html

$(BUILD)/$(ENGINE)/%.o: $(ENGINE)/%.c
	@mkdir -p $(dir $@)
	$(EMCC) $(CFLAGS) $(ENGINE_CFLAGS) -c $< -o $@

$(BUILD)/platform/%.o: platform/%.c
	@mkdir -p $(dir $@)
	$(EMCC) $(CFLAGS) -c $< -o $@

-include $(OBJS:.o=.d)

$(DIST)/doom.js: $(OBJS) $(WAD)
	@mkdir -p $(DIST)
	$(EMCC) $(OBJS) $(LDFLAGS) -o $@

WEB_FILES := web/index.html web/input_audio.js web/audio_web.js web/render_timing.js
)

