await (async (page) => {
  await page.setViewportSize({width:1280,height:720});
  const cdp = await page.context().newCDPSession(page);
  await cdp.send('Network.enable'); await cdp.send('Network.clearBrowserCache'); await cdp.send('Network.setCacheDisabled',{cacheDisabled:true});
  const reqs=[], fails=[], errs=[], cons=[];
  page.on('response', r=>reqs.push({url:r.url().replace(/^https?:\/\/[^/]+/,''), status:r.status(), fromCache:r.fromServiceWorker()}));
  page.on('requestfailed', r=>fails.push({url:r.url(), err:r.failure()&&r.failure().errorText}));
  page.on('pageerror', e=>errs.push(String(e)));
  page.on('console', m=>cons.push({type:m.type(), text:m.text().slice(0,200)}));
  const t0=Date.now();
  await page.goto('http://localhost:8000/?r='+t0, {waitUntil:'commit'});
  const series=[];
  const sample = () => page.evaluate(() => {
    const c=document.getElementById('canvas');
    let tic=null; try{ tic = (window.Module && Module._cap_tic_count) ? Module._cap_tic_count() : null }catch(e){}
    let colors=null, transp=null;
    try{ const o=document.createElement('canvas'); o.width=64;o.height=40; const x=o.getContext('2d'); x.drawImage(c,0,0,64,40);
      const d=x.getImageData(0,0,64,40).data; const s=new Set(); transp=0;
      for(let i=0;i<d.length;i+=4){ s.add(d[i]<<16|d[i+1]<<8|d[i+2]); if(d[i+3]===0) transp++; } colors=s.size; }catch(e){ colors='err:'+e }
    return {tic, colors, transp, title:document.title};
  }).catch(e=>({err:String(e)}));
  let firstFrame=null;
  while(Date.now()-t0<5000){ const s=await sample(); s.ms=Date.now()-t0; series.push(s); if(firstFrame===null && s.colors>1 && s.transp===0) firstFrame=s; await page.waitForTimeout(100); }
  await page.screenshot({path:'artifacts/logs/reviewer_site.inVZde/startup.png'});
  const box = await page.evaluate(()=>{const c=document.getElementById('canvas'); const r=c.getBoundingClientRect(); return {w:c.width,h:c.height,cssW:r.width,cssH:r.height,top:r.top,left:r.left}});
  return {reqs, fails, errs, cons, firstFrame, box, series};
})(page);
