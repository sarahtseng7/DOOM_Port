// Rendering and timing for the WebAssembly port (coder_render_timing-owned).
// Strong definitions of the cap_render_* / cap_time_ms / cap_sleep_ms /
// cap_set_title hooks; they override the weak defaults in cap_fallback.c.
// Contract: platform/capstone_bridge.h (version 2).

#include <stdint.h>

#include <emscripten.h>

#include "capstone_bridge.h"
#include "render_timing.h"

// Engine framebuffer bytes are B,G,R,0; canvas ImageData wants R,G,B,A.
// On little-endian wasm the source word is 0x00RRGGBB and the output word
// must be 0xAABBGGRR with A forced to 255.
static uint32_t rgba[CAP_FB_WIDTH * CAP_FB_HEIGHT];

static uint32_t frames_presented;

EM_JS(int, rt_js_init, (int w, int h), {
    var c = Module.canvas || document.getElementById('canvas');
    if (!c) return 0;
    // alpha:false lets the browser skip compositing against the page.
    var ctx = c.getContext('2d', { alpha: false });
    if (!ctx) return 0;
    ctx.imageSmoothingEnabled = false;
    Module._rt = { ctx: ctx, w: w, h: h, frames: 0, lastPresent: 0 };
    // Observable by tests: Module._rt.frames increments once per DG_DrawFrame.
    return 1;
});

EM_JS(void, rt_js_put, (const void *px, int w, int h), {
    var rt = Module._rt;
    if (!rt) return;
    // Reuse the ImageData while the heap buffer and pointer are unchanged;
    // ALLOW_MEMORY_GROWTH replaces HEAPU8.buffer, which invalidates the view.
    if (!rt.img || rt.buf !== HEAPU8.buffer || rt.px !== px) {
        rt.buf = HEAPU8.buffer;
        rt.px = px;
        rt.img = new ImageData(new Uint8ClampedArray(rt.buf, px, w * h * 4), w, h);
    }
    rt.ctx.putImageData(rt.img, 0, 0);
    rt.frames++;
    rt.lastPresent = performance.now();
});

EM_JS(void, rt_js_title, (const char *t), { document.title = UTF8ToString(t); });

void cap_render_init(void)
{
    frames_presented = 0;
    rt_js_init(CAP_FB_WIDTH, CAP_FB_HEIGHT);
}

void cap_render_present(const pixel_t *fb)
{
    const uint32_t *src = (const uint32_t *)fb;
    for (int i = 0; i < CAP_FB_WIDTH * CAP_FB_HEIGHT; i++) {
        uint32_t s = src[i];
        rgba[i] = 0xFF000000u | ((s & 0xFFu) << 16) | (s & 0xFF00u) | ((s >> 16) & 0xFFu);
    }
    rt_js_put(rgba, CAP_FB_WIDTH, CAP_FB_HEIGHT);
    frames_presented++;
}

uint32_t cap_time_ms(void)
{
    // Milliseconds since page start (monotonic). +1 keeps the first call
    // nonzero: i_timer.c treats basetime==0 as unset.
    return (uint32_t)emscripten_get_now() + 1;
}

// The engine only sleeps in 1 ms polls (wipe loop in d_main.c, tic wait in
// d_loop.c) and a 100 ms retry in d_loop.c. With ASYNCIFY, emscripten_sleep
// returns control to the event loop via setTimeout, so input, rAF and
// painting keep running while the engine waits and real time advances.
void cap_sleep_ms(uint32_t ms)
{
    emscripten_sleep(ms);
}

void cap_set_title(const char *title)
{
    rt_js_title(title);
}

uint32_t cap_render_frames(void)
{
    return frames_presented;
}
// Private header for platform/render_timing.c (coder_render_timing-owned).
// The cross-module hooks are declared in capstone_bridge.h; only extras here.
#ifndef RENDER_TIMING_H
#define RENDER_TIMING_H

#include <stdint.h>

// Number of frames passed to cap_render_present since cap_render_init.
uint32_t cap_render_frames(void);

#endif // RENDER_TIMING_H
// Shared bridge contract between the coder-owned DG adapters
// (platform/doomgeneric_wasm.c) and the specialist modules
// (render_timing.*, input_audio.*). AGENT-PROPOSED; not student-approved.
// Full prose: artifacts/runs/20261103T002748Z-51080/coder/plan/attempt-1/interface-contract.md
// Only the coder role edits this file; request changes via your report.
#ifndef CAPSTONE_BRIDGE_H
#define CAPSTONE_BRIDGE_H

#include <stdint.h>

#include "doomgeneric.h"

#ifdef __EMSCRIPTEN__
#include <emscripten.h>
#define CAP_EXPORT EMSCRIPTEN_KEEPALIVE
#else
#define CAP_EXPORT
#endif

#ifdef __cplusplus
extern "C" {
#endif

// v3: added cap_input_impl(), cap_input_delivered_count(), cap_input_dropped_count().
// v2: added cap_tic_count(). Specialist hooks have WEAK defaults in
// platform/cap_fallback.c; a strong definition in another platform/*.c wins.
#define CAP_BRIDGE_VERSION 3

// Framebuffer: DG_ScreenBuffer is DOOMGENERIC_RESX x DOOMGENERIC_RESY
// (640x400) pixel_t (uint32_t). Memory bytes per pixel are B,G,R,0 (alpha is
// NOT set); the render module converts to opaque RGBA for canvas ImageData.
#define CAP_FB_WIDTH   DOOMGENERIC_RESX
#define CAP_FB_HEIGHT  DOOMGENERIC_RESY
#define CAP_FB_BYTES   (CAP_FB_WIDTH * CAP_FB_HEIGHT * 4)

// Paths inside the Emscripten virtual FS.
#define CAP_WAD_PATH   "/doom1.wad"

// ---- Owner: coder (platform/doomgeneric_wasm.c) -------------------------
// The DG_* callbacks in doomgeneric.h are thin adapters that forward to the
// cap_* functions below. Only the coder defines the DG_* symbols and main().
CAP_EXPORT int      cap_bridge_version(void);        // returns CAP_BRIDGE_VERSION
CAP_EXPORT const void *cap_framebuffer_ptr(void);    // DG_ScreenBuffer address (valid after startup)
CAP_EXPORT int      cap_tic_count(void);             // engine gametic (35/s at full speed); for T2 checks
CAP_EXPORT int      cap_input_impl(void);            // 1 = input_audio.c linked, 0 = cap_fallback.c queue
CAP_EXPORT unsigned cap_input_delivered_count(void); // events handed to the engine (0 if fallback)
CAP_EXPORT unsigned cap_input_dropped_count(void);   // events refused by the queue (0 if fallback)
CAP_EXPORT int      cap_ready(void);                 // 1 once doomgeneric_Create() returned

// ---- Owner: coder_render_timing (platform/render_timing.c) --------------
void     cap_render_init(void);                      // from DG_Init
void     cap_render_present(const pixel_t *fb);      // from DG_DrawFrame; must not retain fb
uint32_t cap_time_ms(void);                          // from DG_GetTicksMs; monotonic, ms
                                                     // since page start, MUST be nonzero
                                                     // by the first engine call (i_timer.c
                                                     // treats basetime==0 as unset)
void     cap_sleep_ms(uint32_t ms);                  // from DG_SleepMs (engine wipe/tic waits)
void     cap_set_title(const char *title);           // from DG_SetWindowTitle

// ---- Owner: coder_input_audio (platform/input_audio.c) ------------------
// Optional diagnostics (strong in input_audio.c; absent in the fallback):
unsigned cap_input_delivered(void) __attribute__((weak));
unsigned cap_input_dropped(void) __attribute__((weak));
void cap_input_init(void);                           // from DG_Init
int  cap_input_poll(int *pressed, unsigned char *doom_key); // from DG_GetKey; 1=event
                                                     // returned, 0=queue empty.
                                                     // doom_key is a doomkeys.h code.
CAP_EXPORT void cap_input_event(int pressed, int doom_key); // JS->C enqueue (bounded queue)
CAP_EXPORT void cap_input_reset(void);               // release all keys (blur/visibility)
void cap_audio_init(void);                           // optional; no-op until audio scope approved

#ifdef __cplusplus
}
#endif

#endif // CAPSTONE_BRIDGE_H
// WebAssembly platform layer for doomgeneric (coder-owned).
// DG_* callbacks forward to the cap_* functions declared in capstone_bridge.h.
// Default (weak) cap_* implementations live in cap_fallback.c; specialist
// modules override them with strong definitions.

#include <stdint.h>

#include <emscripten.h>

#include "capstone_bridge.h"

extern int gametic;

static int cap_started;

void DG_Init()
{
    cap_render_init();
    cap_input_init();
    cap_audio_init();
}

void DG_DrawFrame()
{
    cap_render_present(DG_ScreenBuffer);
}

void DG_SleepMs(uint32_t ms)
{
    cap_sleep_ms(ms);
}

uint32_t DG_GetTicksMs()
{
    return cap_time_ms();
}

int DG_GetKey(int *pressed, unsigned char *key)
{
    return cap_input_poll(pressed, key);
}

void DG_SetWindowTitle(const char *title)
{
    cap_set_title(title);
}

int cap_bridge_version(void)
{
    return CAP_BRIDGE_VERSION;
}

int cap_ready(void)
{
    return cap_started;
}

int cap_input_impl(void)
{
    return cap_input_delivered != NULL;
}

unsigned cap_input_delivered_count(void)
{
    return cap_input_delivered ? cap_input_delivered() : 0;
}

unsigned cap_input_dropped_count(void)
{
    return cap_input_dropped ? cap_input_dropped() : 0;
}

const void *cap_framebuffer_ptr(void)
{
    return DG_ScreenBuffer;
}

int cap_tic_count(void)
{
    return gametic;
}

int main(int argc, char **argv)
{
    static char *args[] = { "doom", "-iwad", CAP_WAD_PATH, NULL };
    (void)argc;
    (void)argv;

    doomgeneric_Create(3, args);
    cap_started = 1;

    // ASYNCIFY build: cap_sleep_ms yields to the browser inside the engine's
    // tic waits; the explicit sleep(0) yields once per frame otherwise.
    for (;;) {
        doomgeneric_Tick();
        emscripten_sleep(0);
    }
    return 0;
}
