```js
await (async (page) => {
  await page.setViewportSize({width:1280,height:720});
  const cdp = await page.context().newCDPSession(page);
  await cdp.send('Network.enable'); await cdp.send('Network.clearBrowserCache'); await cdp.send('Network.setCacheDisabled',{cacheDisabled:true});
  const resp=[]; page.on('response', r=>resp.push(`${r.status()} ${r.url()} fromCache=${r.fromServiceWorker()}`));
  const fails=[]; page.on('requestfailed', r=>fails.push(r.url()));
  const errs=[]; page.on('pageerror', e=>errs.push(String(e)));
  const t0=Date.now();
  await page.goto('http://localhost:8000/', {waitUntil:'commit'});
  const samples=[];
  for (let i=0;i<60;i++){
    const s = await page.evaluate(()=>{
      const c=document.querySelector('canvas'); let info={};
      if(c){ try{ const tmp=document.createElement('canvas'); tmp.width=c.width; tmp.height=c.height; const x=tmp.getContext('2d'); x.drawImage(c,0,0); const d=x.getImageData(0,0,c.width,c.height).data; let tr=0,r=0,g=0,b=0,n=0; const buckets=new Set(); for(let k=0;k<d.length;k+=64){ if(d[k+3]===0)tr++; r+=d[k];g+=d[k+1];b+=d[k+2];n++; buckets.add((d[k]>>5)<<6|(d[k+1]>>5)<<3|(d[k+2]>>5)); } info={w:c.width,h:c.height,transparentFrac:+(tr/n).toFixed(3),mean:[r/n|0,g/n|0,b/n|0],buckets:buckets.size}; }catch(e){info.err=String(e)} }
      const M=window.Module; let tic=null; try{ if(M&&M._cap_tic_count) tic=M._cap_tic_count(); }catch(e){}
      return {title:document.title, tic, ...info};
    });
    samples.push({t:Date.now()-t0, ...s});
    await page.waitForTimeout(100);
  }
  return JSON.stringify({resp,fails,errs,samples});
})(page);
```
