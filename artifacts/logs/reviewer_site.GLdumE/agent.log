await (async (page) => {
  const r = await page.evaluate(async()=>{
    const M=window.Module; const t0=performance.now(); const tic0=M._cap_tic_count();
    let maxGap=0,last=t0,lastTic=tic0,lastTicT=t0,maxStall=0;
    await new Promise(res=>{ function f(){ const n=performance.now(); maxGap=Math.max(maxGap,n-last); last=n; const t=M._cap_tic_count(); if(t!==lastTic){maxStall=Math.max(maxStall,n-lastTicT); lastTic=t; lastTicT=n;} if(n-t0<6000) requestAnimationFrame(f); else res(); } requestAnimationFrame(f); });
    const t1=performance.now(), tic1=M._cap_tic_count();
    const c=document.querySelector('canvas').getBoundingClientRect();
    return {tic0,tic1,secs:(t1-t0)/1000,rate:(tic1-tic0)/((t1-t0)/1000),maxRafGapMs:maxGap,maxTicStallMs:maxStall,canvasRect:[c.x,c.y,c.width,c.height],scroll:[document.documentElement.scrollWidth,document.documentElement.scrollHeight]};
  });
  return JSON.stringify(r);
})(page);
