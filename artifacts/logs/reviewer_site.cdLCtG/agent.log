        for (let k = 0; k < d.length; k += 4) { set.add((d[k]<<16)|(d[k+1]<<8)|d[k+2]); if (d[k+3] < 255) transp++; }
        colors = set.size;
      } catch (e) { colors = -1; }
      return {tic, colors, transp, title: document.title, cw: c.width, ch: c.height, css: c.getBoundingClientRect().width + 'x' + c.getBoundingClientRect().height};
    });
    s.t = Date.now() - t0; series.push(s);
