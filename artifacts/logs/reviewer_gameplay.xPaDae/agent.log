  await key('Control', 150); await sleep(900); const post = await S(); const after = await shot(`03-${nm}-fired`);
  weap[nm] = { sfxDelta: post.sfx - pre.sfx, ammoDiff: +diffFrac(img, after, AMMO).toFixed(4), hp: post.hp };
