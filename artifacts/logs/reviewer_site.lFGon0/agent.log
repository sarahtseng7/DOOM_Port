    const M=window.Module; const tic0=M._cap_tic_count(); const t0=performance.now();
    let last=t0, maxGap=0, lastTic=tic0, lastTicT=t0, maxStall=0;
    function f(now){ maxGap=Math.max(maxGap, now-last); last=now; const t=M._cap_tic_count();
      if(t!==lastTic){ maxStall=Math.max(maxStall, now-lastTicT); lastTic=t; lastTicT=now; }
      if(now-t0<6000) requestAnimationFrame(f); else res({tic0, tic1:t, secs:(now-t0)/1000, ticsPerSec:(t-tic0)/((now-t0)/1000), maxRafGapMs:+maxGap.toFixed(1), maxTicStallMs:+maxStall.toFixed(1)}); }
    requestAnimationFrame(f);
