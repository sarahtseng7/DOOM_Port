await (async (page) => {
  await page.setViewportSize({width:1280,height:720});
  const cdp = await page.context().newCDPSession(page);
  await cdp.send('Network.enable');
  await cdp.send('Network.clearBrowserCache');
  await cdp.send('Network.setCacheDisabled',{cacheDisabled:true});
  const responses=[], failed=[], pageerrors=[], cons=[];
  page.on('response', r => responses.push([new URL(r.url()).pathname, r.status(), r.fromServiceWorker()]));
  page.on('requestfailed', r => failed.push(r.url()));
  page.on('pageerror', e => pageerrors.push(String(e)));
  page.on('console', m => cons.push([m.type(), m.text().slice(0,160)]));
  const t0 = Date.now();
  await page.goto('http://localhost:8000/', {waitUntil:'commit'});
  const sample = () => page.evaluate(() => {
    const c=document.getElementById('canvas'); let mean=[0,0,0], transp=0, n=0;
    try { const g=document.createElement('canvas'); g.width=64; g.height=40; const x=g.getContext('2d'); x.drawImage(c,0,0,64,40);
      const d=x.getImageData(0,0,64,40).data; for(let i=0;i<d.length;i+=4){n++; if(d[i+3]===0)transp++; mean[0]+=d[i];mean[1]+=d[i+1];mean[2]+=d[i+2];}
      mean=mean.map(v=>Math.round(v/n)); } catch(e){ mean=String(e); }
    const M=window.Module||{}; const f=k=>{try{return M[k]?M[k]():null}catch(e){return 'err'}};
    return {cap_ready:f('_cap_ready'), tic:f('_cap_tic_count'), canvas:c.width+'x'+c.height, meanRGB:mean, transparent_of:transp+'/'+n, title:document.title};
  });
  const samples=[];
  for (const target of [100,300,600,1000,2000]) { const w=target-(Date.now()-t0); if(w>0) await page.waitForTimeout(w); samples.push({t_ms:Date.now()-t0, ...(await sample())}); }
  return JSON.stringify({responses, failed, pageerrors, samples, console:cons.filter(c=>c[0]!=='log'), logs:cons.filter(c=>c[0]==='log').length, logSample:cons.slice(0,25)});
})(page);
