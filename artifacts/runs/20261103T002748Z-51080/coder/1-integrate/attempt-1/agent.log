# Building the Doom WebAssembly port

Toolchain: Emscripten **4.0.18** (`source ~/Developer/emsdk/emsdk_env.sh`), GNU make, Node (tests only).

    make        # builds build/*.o and dist/{index.html,doom.js,doom.wasm,doom.data}
    make clean  # removes build/ and dist/

- Engine sources: all `third_party/doomgeneric/*.c` except `dummy.c`, `doomgeneric_sdl.c`; platform code: `platform/*.c`.
- WAD packaging: `assets/doom1.wad` is embedded via `--preload-file` at `/doom1.wad` in `dist/doom.data`.
- `web/index.html` is copied to `dist/index.html`. Serve `dist/` over HTTP (not `file://`).
- JS/C bridge exports are listed in the Makefile `EXPORTED_FUNCTIONS`; see `platform/capstone_bridge.h`.
- Acceptance: `tests/verify.sh` (tester-owned); `QUICK=1` is partial and never exits 0.
# Doom -> WebAssembly build. Requires Emscripten 4.0.18 (source emsdk_env.sh
# or use the Dockerfile image). Output: dist/{index.html,doom.js,doom.wasm,doom.data}
EMCC      ?= emcc
ENGINE    := third_party/doomgeneric
BUILD     := build
DIST      := dist
WAD       := assets/doom1.wad

# Platform-specific/unused engine files: dummy.c, i_cdmus.c, i_joystick.c are
# stubs here; net_* sources are absent from this tree.
ENGINE_EXCLUDE := $(ENGINE)/dummy.c $(ENGINE)/doomgeneric_sdl.c
ENGINE_SRC := $(filter-out $(ENGINE_EXCLUDE),$(wildcard $(ENGINE)/*.c))
PLAT_SRC   := $(wildcard platform/*.c)
OBJS       := $(patsubst %.c,$(BUILD)/%.o,$(ENGINE_SRC) $(PLAT_SRC))

CFLAGS  := -O2 -I$(ENGINE) -Iplatform -w
LDFLAGS := -O2 -sASYNCIFY -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=64MB \
           -sEXPORTED_FUNCTIONS=_main,_cap_frame,_cap_ready,_cap_tic_count,_cap_input_event,_cap_input_reset,_cap_bridge_version,_cap_framebuffer_ptr \
           -sEXPORTED_RUNTIME_METHODS=ccall,cwrap,HEAPU8 \
           --preload-file $(WAD)@/doom1.wad

.PHONY: all clean
all: $(DIST)/index.html

$(BUILD)/%.o: %.c platform/capstone_bridge.h
	@mkdir -p $(dir $@)
	$(EMCC) $(CFLAGS) -c $< -o $@

$(DIST)/doom.js: $(OBJS) $(WAD)
	@mkdir -p $(DIST)
	$(EMCC) $(OBJS) $(LDFLAGS) -o $@

$(DIST)/index.html: $(DIST)/doom.js web/index.html
	cp web/index.html $@

clean:
	rm -rf $(BUILD) $(DIST)
#!/usr/bin/env bash
# Acceptance entry point (tester-owned). Exit 0 only if build + every required check passes.
# Env: RUN_ID (evidence dir name), SOAK_SECONDS (default 300), QUICK=1 (partial; never exits 0),
#      SKIP_BUILD=1 is intentionally NOT supported.
set -u
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
RUN_ID="${RUN_ID:-manual-$(date -u +%Y%m%dT%H%M%SZ)}"
OUT_DIR="${OUT_DIR:-artifacts/runs/$RUN_ID/tester/verify-$(date -u +%H%M%SZ)}"
mkdir -p "$OUT_DIR"
export OUT_DIR
fail() { echo "VERIFY FAIL: $1" | tee -a "$OUT_DIR/verify.log"; exit "${2:-1}"; }
step() { echo "== $1" | tee -a "$OUT_DIR/verify.log"; }

# Identity of what was tested.
{
  echo "commit: $(git rev-parse HEAD)"
  echo "dirty_diff_sha256: $(git diff HEAD -- . ':!artifacts' | shasum -a 256 | cut -d' ' -f1)"
  git status --short -- . ':!artifacts' | sed 's/^/status: /'
  echo "tests_sha256: $(cat tests/verify.sh tests/playtest.mjs tests/selftest.mjs tests/lib/frames.mjs tests/package.json | shasum -a 256 | cut -d' ' -f1)"
  echo "wad_sha256: $(shasum -a 256 assets/doom1.wad | cut -d' ' -f1)"
  echo "emcc: $(emcc --version 2>/dev/null | head -1 || echo missing)"
} > "$OUT_DIR/identity.txt"

step "tooling"
command -v node >/dev/null || fail "node missing" 2
command -v make >/dev/null || fail "make missing" 2
command -v emcc >/dev/null || fail "emcc missing (source emsdk 4.0.18 env)" 2
(cd tests && npm ci --no-audit --no-fund >>"$OUT_DIR/verify.log" 2>&1) || fail "npm ci in tests/ failed" 2
(cd tests && npx playwright install chromium >>"$OUT_DIR/verify.log" 2>&1) || fail "playwright chromium install failed" 2

step "helper self-test (fault injection on pixel checks)"
node tests/selftest.mjs 2>&1 | tee "$OUT_DIR/selftest.log"; [ "${PIPESTATUS[0]}" -eq 0 ] || fail "selftest failed"

step "clean build"
{ make clean && make all; } >"$OUT_DIR/build.log" 2>&1 || fail "make clean && make all failed (see $OUT_DIR/build.log)"
[ -f dist/index.html ] && [ -f dist/doom.wasm ] || fail "dist/index.html or dist/doom.wasm missing after build"
shasum -a 256 dist/* > "$OUT_DIR/dist-sha256.txt" 2>/dev/null

step "browser playtest"
node tests/playtest.mjs 2>&1 | tee "$OUT_DIR/playtest.log"
rc=${PIPESTATUS[0]}
echo "{\"exit\": $rc, \"evidence\": \"$OUT_DIR\"}" > "$OUT_DIR/verify-result.json"
exit "$rc"
)

