  // Physical codes currently held (so keyup always matches its keydown even
  // if the layout/modifiers changed in between).
  var held = {};

  function mod() { return window.Module; }
  function ready() {
    var M = mod();
    return !!(M && M.calledRun && M._cap_input_event);
  }

  function send(pressed, key) {
    if (ready()) mod()._cap_input_event(pressed, key);
  }

  // Keys the browser needs: reload/fullscreen/devtools, and Ctrl+letter/digit
  // (Ctrl is also Doom fire, so the key is still forwarded, just not blocked).
  function browserShortcut(e) {
    if (e.code === 'F5' || e.code === 'F11' || e.code === 'F12') return true;
    return e.ctrlKey && /^(Key[A-Z]|Digit\d)$/.test(e.code);
  }

  function onKeyDown(e) {
    var key = doomKey(e.code);
    // Leave browser/OS shortcuts (Cmd+R, Ctrl is fire so only Meta is checked).
    if (!key || e.metaKey) return;
    if (!browserShortcut(e)) e.preventDefault();
    // Auto-repeat of a key we already hold: Doom repeats itself. A repeat for
    // a key we do NOT hold means releaseAll() ran while it was still down
    // (refocus), so treat it as a fresh press.
    if (held[e.code]) return;
    var already = false;
    for (var c in held) if (held[c] === key) already = true;
    held[e.code] = key;
    if (!already) send(1, key); // L+R Ctrl map to one doom key: one press
  }

  function onKeyUp(e) {
    var key = held[e.code];
    if (!key) {
      if (doomKey(e.code)) e.preventDefault();
      return;
    }
    delete held[e.code];
    e.preventDefault();
    // Two physical keys can map to one doom key (left/right Ctrl): release
    // only when no other held code maps to it.
    for (var c in held) if (held[c] === key) return;
    send(0, key);
  }

  // Focus/visibility loss: browsers drop keyups, so release everything.
  function releaseAll() {
    held = {};
    if (ready() && mod()._cap_input_reset) mod()._cap_input_reset();
  }

  window.addEventListener('keydown', onKeyDown);
  window.addEventListener('keyup', onKeyUp);
  window.addEventListener('blur', releaseAll);
  window.addEventListener('pagehide', releaseAll);
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) releaseAll();
  });
  // Ctrl+click / right-click opens a menu and swallows the matching keyup.
  window.addEventListener('contextmenu', function (e) { e.preventDefault(); releaseAll(); });
  // Cmd (macOS) swallows keyups for other keys while held.
  window.addEventListener('keydown', function (e) { if (e.key === 'Meta') releaseAll(); });

  window.CapInput = { doomKey: doomKey, releaseAll: releaseAll, held: function () { return Object.keys(held); } };
})();
#!/usr/bin/env bash
# Acceptance entry point (tester-owned). Exit 0 only if build + every required check passes.
# Env: RUN_ID (evidence dir name), SOAK_SECONDS (default 300), QUICK=1 (partial; never exits 0),
#      SKIP_BUILD=1 is intentionally NOT supported.
set -u
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
RUN_ID="${RUN_ID:-manual-$(date -u +%Y%m%dT%H%M%SZ)}"
OUT_DIR="${OUT_DIR:-artifacts/runs/$RUN_ID/tester/verify-$(date -u +%H%M%SZ)}"
mkdir -p "$OUT_DIR"
export OUT_DIR
fail() { echo "VERIFY FAIL: $1" | tee -a "$OUT_DIR/verify.log"; exit "${2:-1}"; }
step() { echo "== $1" | tee -a "$OUT_DIR/verify.log"; }

# Identity of what was tested.
{
  echo "commit: $(git rev-parse HEAD)"
  echo "dirty_diff_sha256: $(git diff HEAD -- . ':!artifacts' | shasum -a 256 | cut -d' ' -f1)"
  git status --short -- . ':!artifacts' | sed 's/^/status: /'
  echo "tests_sha256: $(cat tests/verify.sh tests/playtest.mjs tests/selftest.mjs tests/lib/frames.mjs tests/package.json | shasum -a 256 | cut -d' ' -f1)"
  echo "wad_sha256: $(shasum -a 256 assets/doom1.wad | cut -d' ' -f1)"
  echo "emcc: $(emcc --version 2>/dev/null | head -1 || echo missing)"
} > "$OUT_DIR/identity.txt"

step "tooling"
command -v node >/dev/null || fail "node missing" 2
command -v make >/dev/null || fail "make missing" 2
command -v emcc >/dev/null || fail "emcc missing (source emsdk 4.0.18 env)" 2
(cd tests && npm ci --no-audit --no-fund >>"$OUT_DIR/verify.log" 2>&1) || fail "npm ci in tests/ failed" 2
(cd tests && npx playwright install chromium >>"$OUT_DIR/verify.log" 2>&1) || fail "playwright chromium install failed" 2

step "helper self-test (fault injection on pixel checks)"
node tests/selftest.mjs 2>&1 | tee "$OUT_DIR/selftest.log"; [ "${PIPESTATUS[0]}" -eq 0 ] || fail "selftest failed"

step "clean build"
{ make clean && make all; } >"$OUT_DIR/build.log" 2>&1 || fail "make clean && make all failed (see $OUT_DIR/build.log)"
[ -f dist/index.html ] && [ -f dist/doom.wasm ] || fail "dist/index.html or dist/doom.wasm missing after build"
shasum -a 256 dist/* > "$OUT_DIR/dist-sha256.txt" 2>/dev/null

step "browser playtest"
node tests/playtest.mjs 2>&1 | tee "$OUT_DIR/playtest.log"
rc=${PIPESTATUS[0]}
echo "{\"exit\": $rc, \"evidence\": \"$OUT_DIR\"}" > "$OUT_DIR/verify-result.json"
exit "$rc"
)
