diff --git a/loop/loop.sh b/loop/loop.sh
old mode 100644
new mode 100755
index 40c0cf4..3303c38
--- a/loop/loop.sh
+++ b/loop/loop.sh
@@ -1,3 +1,82 @@
-#!/bin/bash
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "${BASH_SOURCE[0]}")/.."
 
-set -eu
\ No newline at end of file
+MAX_ITERATIONS="${MAX_ITERATIONS:-10}"
+TIMEOUT_SECONDS="${TIMEOUT_SECONDS:-1200}" # 20 minutes per agent/check
+[[ "$MAX_ITERATIONS" =~ ^[1-9][0-9]*$ && "$TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]] || exit 2
+export RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"
+RUN="artifacts/runs/$RUN_ID"
+mkdir -p "$RUN"
+printf 'run_id: %s\nsource_commit: %s\n' "$RUN_ID" "$(git rev-parse HEAD)" > "$RUN/manifest.txt"
+
+# Keep the terminal updated; terminate a hung command and its children.
+run_logged() {
+  python3 - "$TIMEOUT_SECONDS" "$@" <<'PY'
+import os, signal, subprocess, sys, time
+limit, log = int(sys.argv[1]), sys.argv[2]
+with open(log, 'w') as output:
+    p = subprocess.Popen(sys.argv[3:], stdout=output, stderr=subprocess.STDOUT, start_new_session=True)
+    start = time.monotonic()
+    try:
+        while True:
+            remaining = limit - (time.monotonic() - start)
+            if remaining <= 0:
+                raise TimeoutError()
+            try:
+                code = p.wait(timeout=min(30, remaining))
+                break
+            except subprocess.TimeoutExpired:
+                print(f'Still running ({int(time.monotonic()-start)}s). Log: {log}', flush=True)
+    except (TimeoutError, KeyboardInterrupt):
+        os.killpg(p.pid, signal.SIGTERM)
+        try: p.wait(timeout=5)
+        except subprocess.TimeoutExpired:
+            os.killpg(p.pid, signal.SIGKILL)
+            p.wait()
+        print(f'Stopped: interrupted or exceeded {limit}s. Log: {log}', file=sys.stderr)
+        sys.exit(124)
+print(f'Finished: exit {code}. Log: {log}', flush=True)
+sys.exit(code if code >= 0 else 128-code)
+PY
+}
+
+run_agent() {
+  local agent="$1" task_id="$2" task="$3"
+  local dir="$RUN/$agent/$task_id/attempt-1"
+  mkdir -p "$dir"
+  local message="Role=$agent RUN_ID=$RUN_ID TASK_ID=$task_id ATTEMPT_ID=attempt-1.
+OUTPUT_DIR=$dir. Manifest: $RUN/manifest.txt. Task: $task
+Follow your configured role prompt. Read earlier findings under artifacts/runs/.
+Use artifacts/specification.md, artifacts/acceptance-criteria.md and
+artifacts/interface-contract.md if present. Otherwise use proposals under
+$RUN/coder/plan/attempt-1/ and $RUN/tester/prepare/attempt-1/.
+Record reasonable assumptions if optional documents are absent; do not invent approval.
+Save report.md and result.json in OUTPUT_DIR. Partial work is FINDINGS, not PASS."
+  printf '%s\n' "$message" > "$dir/invocation.txt"
+  echo "Running $agent ($task_id). Live log: $dir/agent.log"
+  run_logged "$dir/agent.log" docker agent run loop/agents.yaml --agent "$agent" --exec "$message"
+}
+
+run_agent coder plan "Draft missing proposed-spec.md and interface-contract.md; establish the shared header. Planning only."
+run_agent tester prepare "Draft missing proposed-criteria.md and create verification scripts before implementation."
+
+for ((i=1; i<=MAX_ITERATIONS; i++)); do
+  echo "Iteration $i/$MAX_ITERATIONS — run $RUN_ID"
+  run_agent coder "$i-build" "Implement/repair owned build, startup and WAD packaging."
+  run_agent coder_render_timing "$i-render" "Implement/repair owned rendering and timing."
+  run_agent coder_input_audio "$i-input" "Implement/repair owned controls and documented audio/storage scope."
+  run_agent coder "$i-integrate" "Integrate specialist handoffs through owned files."
+  run_agent reviewer "$i-review" "Review technical correctness; save actionable findings."
+  run_agent tester "$i-test" "Run existing checks; preserve failures; do not weaken tests."
+  run_agent reviewer_requirements "$i-audit" "Audit requirements and evidence; report missing obligations."
+  echo "Running verification."
+  if run_logged "$RUN/verification-$i.log" bash tests/verify.sh; then
+    echo "Candidate verification passed. Review reports before final acceptance."
+    exit 0
+  fi
+  echo "Verification failed or timed out; continuing with saved findings."
+done
+
+echo "Maximum iterations reached without passing verification. Evidence: $RUN"
+exit 1
