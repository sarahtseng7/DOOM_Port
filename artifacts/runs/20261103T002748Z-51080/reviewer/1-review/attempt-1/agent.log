// Rendering and timing for the WebAssembly port (coder_render_timing-owned).
// Strong definitions of the cap_render_* / cap_time_ms / cap_sleep_ms /
// cap_set_title hooks; they override the weak defaults in cap_fallback.c.
// Contract: platform/capstone_bridge.h (version 2).

#include <stdint.h>

#include <emscripten.h>

#include "capstone_bridge.h"
#include "render_timing.h"

// Engine framebuffer bytes are B,G,R,0; canvas ImageData wants R,G,B,A.
// On little-endian wasm the source word is 0x00RRGGBB and the output word
// must be 0xAABBGGRR with A forced to 255.
static uint32_t rgba[CAP_FB_WIDTH * CAP_FB_HEIGHT];

static uint32_t frames_presented;

EM_JS(int, rt_js_init, (int w, int h), {
    var c = Module.canvas || document.getElementById('canvas');
    if (!c) return 0;
    // alpha:false lets the browser skip compositing against the page.
    var ctx = c.getContext('2d', { alpha: false });
    if (!ctx) return 0;
    ctx.imageSmoothingEnabled = false;
    Module._rt = { ctx: ctx, w: w, h: h, frames: 0, lastPresent: 0 };
    // Observable by tests: Module._rt.frames increments once per DG_DrawFrame.
    return 1;
});

EM_JS(void, rt_js_put, (const void *px, int w, int h), {
    var rt = Module._rt;
    if (!rt) return;
    // Rebuild the view every frame: ALLOW_MEMORY_GROWTH replaces the buffer.
    var data = new Uint8ClampedArray(HEAPU8.buffer, px, w * h * 4);
    rt.ctx.putImageData(new ImageData(data, w, h), 0, 0);
    rt.frames++;
    rt.lastPresent = performance.now();
});

EM_JS(void, rt_js_title, (const char *t), { document.title = UTF8ToString(t); });

void cap_render_init(void)
{
    frames_presented = 0;
    rt_js_init(CAP_FB_WIDTH, CAP_FB_HEIGHT);
}

void cap_render_present(const pixel_t *fb)
{
    const uint32_t *src = (const uint32_t *)fb;
    for (int i = 0; i < CAP_FB_WIDTH * CAP_FB_HEIGHT; i++) {
        uint32_t s = src[i];
        rgba[i] = 0xFF000000u | ((s & 0xFFu) << 16) | (s & 0xFF00u) | ((s >> 16) & 0xFFu);
    }
    rt_js_put(rgba, CAP_FB_WIDTH, CAP_FB_HEIGHT);
    frames_presented++;
}

uint32_t cap_time_ms(void)
{
    // Milliseconds since page start (monotonic). +1 keeps the first call
    // nonzero: i_timer.c treats basetime==0 as unset.
    return (uint32_t)emscripten_get_now() + 1;
}

// The engine only sleeps in 1 ms polls (wipe loop in d_main.c, tic wait in
// d_loop.c) and a 100 ms retry in d_loop.c. With ASYNCIFY, emscripten_sleep
// returns control to the event loop via setTimeout, so input, rAF and
// painting keep running while the engine waits and real time advances.
void cap_sleep_ms(uint32_t ms)
{
    emscripten_sleep(ms);
}

void cap_set_title(const char *title)
{
    rt_js_title(title);
}

uint32_t cap_render_frames(void)
{
    return frames_presented;
}
// Browser keyboard capture for the Doom port (coder_input_audio-owned).
// Maps KeyboardEvent.code -> doomkeys.h codes and forwards to the C queue
// (cap_input_event / cap_input_reset). Self-installing; resolves `Module`
// lazily, so script order relative to the Emscripten glue does not matter.
// Load with: <script src="input_audio.js"></script>
// Audio and persistence are not implemented here (scope undecided).
(function () {
  'use strict';

  var KEYS = {
    ArrowLeft: 0xac, ArrowRight: 0xae, ArrowUp: 0xad, ArrowDown: 0xaf,
    ControlLeft: 0xa3, ControlRight: 0xa3, Space: 0xa2,
    ShiftLeft: 0xb6, ShiftRight: 0xb6, AltLeft: 0xb8, AltRight: 0xb8,
    Comma: 0xa0, Period: 0xa1, Enter: 13, NumpadEnter: 13, Escape: 27,
    Tab: 9, Backspace: 0x7f, Pause: 0xff, Minus: 0x2d, Equal: 0x3d,
    NumpadSubtract: 0x2d, NumpadAdd: 0x3d, Slash: 0x2f,
    Home: 0xc7, End: 0xcf, PageUp: 0xc9, PageDown: 0xd1,
    Insert: 0xd2, Delete: 0xd3,
    Numpad8: 0xad, Numpad2: 0xaf, Numpad4: 0xac, Numpad6: 0xae,
    F1: 0xbb, F2: 0xbc, F3: 0xbd, F4: 0xbe, F5: 0xbf, F6: 0xc0,
    F7: 0xc1, F8: 0xc2, F9: 0xc3, F10: 0xc4, F11: 0xd7, F12: 0xd8
  };

  // KeyboardEvent.code -> doom key; 0 if unmapped.
  function doomKey(code) {
    if (Object.prototype.hasOwnProperty.call(KEYS, code)) return KEYS[code];
    var m = /^Key([A-Z])$/.exec(code);
    if (m) return m[1].toLowerCase().charCodeAt(0);
    m = /^Digit(\d)$/.exec(code);
    return m ? m[1].charCodeAt(0) : 0;
  }

  // Physical codes currently held (so keyup always matches its keydown even
  // if the layout/modifiers changed in between).
  var held = {};

  function mod() { return window.Module; }
  function ready() {
    var M = mod();
    return !!(M && M.calledRun && M._cap_input_event);
  }

  function send(pressed, key) {
    if (ready()) mod()._cap_input_event(pressed, key);
  }

  function onKeyDown(e) {
    var key = doomKey(e.code);
    // Leave browser/OS shortcuts (Cmd+R, Ctrl is fire so only Meta is checked).
    if (!key || e.metaKey) return;
    e.preventDefault();
    if (e.repeat || held[e.code]) return; // auto-repeat: Doom repeats itself
    held[e.code] = key;
    send(1, key);
  }

  function onKeyUp(e) {
    var key = held[e.code];
    if (!key) {
      if (doomKey(e.code)) e.preventDefault();
      return;
    }
    delete held[e.code];
    e.preventDefault();
    // Two physical keys can map to one doom key (left/right Ctrl): release
    // only when no other held code maps to it.
    for (var c in held) if (held[c] === key) return;
    send(0, key);
  }

  // Focus/visibility loss: browsers drop keyups, so release everything.
  function releaseAll() {
    held = {};
    if (ready() && mod()._cap_input_reset) mod()._cap_input_reset();
  }

  window.addEventListener('keydown', onKeyDown);
  window.addEventListener('keyup', onKeyUp);
  window.addEventListener('blur', releaseAll);
  window.addEventListener('pagehide', releaseAll);
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) releaseAll();
  });
  // Ctrl+click / right-click opens a menu and swallows the matching keyup.
  window.addEventListener('contextmenu', function (e) { e.preventDefault(); releaseAll(); });
  // Cmd (macOS) swallows keyups for other keys while held.
  window.addEventListener('keydown', function (e) { if (e.key === 'Meta') releaseAll(); });

  window.CapInput = { doomKey: doomKey, releaseAll: releaseAll, held: function () { return Object.keys(held); } };
})();
