// Keyboard input queue for the WebAssembly port (coder_input_audio-owned).
// JS (web/input_audio.js) calls cap_input_event(); the engine drains events via
// DG_GetKey -> cap_input_poll(). Strong definitions override cap_fallback.c.
//
// Invariants:
//  - Events are doomkeys.h codes 1..255.
//  - A press for a key already down (auto-repeat) is dropped; a release for a
//    key that is not down is dropped. The engine therefore sees strictly
//    alternating press/release per key.
//  - A release is never lost to a full queue: presses are refused once
//    PRESS_LIMIT entries are pending, and at most 255 releases can be
//    outstanding, so the queue (2*PRESS_LIMIT) always has room for them.
//  - cap_input_reset() queues a release for every key still down.
// Audio and persistence are NOT implemented (scope undecided); see the report.
#include <string.h>
#include "capstone_bridge.h"
#include "input_audio.h"
#define PRESS_LIMIT 256
#define QSIZE       512 /* power of two */
static struct { unsigned char pressed, key; } q[QSIZE];
static unsigned qhead, qtail;
static unsigned char down[256];
static unsigned dropped, delivered;
static void push(int pressed, int key)
{
    q[qtail % QSIZE].pressed = (unsigned char)pressed;
    q[qtail % QSIZE].key = (unsigned char)key;
    qtail++;
}
void cap_input_init(void)
{
    qhead = qtail = 0;
    memset(down, 0, sizeof down);
}
void cap_audio_init(void)
{
    // Intentionally empty: no audio scope approved (FEATURE_SOUND is not defined by the Makefile, so the engine has no sound path).
}
int cap_input_poll(int *pressed, unsigned char *doom_key)
{
    if (qhead == qtail)
        return 0;
    *pressed = q[qhead % QSIZE].pressed;
    *doom_key = q[qhead % QSIZE].key;
    qhead++;
    delivered++;
    return 1;
}
void cap_input_event(int pressed, int doom_key)
{
    if (doom_key <= 0 || doom_key > 255) {
        dropped++;
        return;
    }
    pressed = pressed != 0;
    if (pressed == down[doom_key]) { // repeat press or stray release
        dropped++;
        return;
    }
    if (pressed && qtail - qhead >= PRESS_LIMIT) {
        dropped++;
        return;
    }
    down[doom_key] = (unsigned char)pressed;
    push(pressed, doom_key);
}
void cap_input_reset(void)
{
    for (int k = 1; k < 256; k++) {
        if (down[k])
            cap_input_event(0, k);
    }
}
unsigned cap_input_dropped(void)   { return dropped; }
unsigned cap_input_delivered(void) { return delivered; }
// Rendering and timing for the WebAssembly port (coder_render_timing-owned).
// Strong definitions of the cap_render_* / cap_time_ms / cap_sleep_ms /
// cap_set_title hooks; they override the weak defaults in cap_fallback.c.
// Contract: platform/capstone_bridge.h (version 2).
#include <stdint.h>
#include <emscripten.h>
#include "capstone_bridge.h"
#include "render_timing.h"
// Engine framebuffer bytes are B,G,R,0; canvas ImageData wants R,G,B,A.
// On little-endian wasm the source word is 0x00RRGGBB and the output word
// must be 0xAABBGGRR with A forced to 255.
static uint32_t rgba[CAP_FB_WIDTH * CAP_FB_HEIGHT];
static uint32_t frames_presented;
EM_JS(int, rt_js_init, (int w, int h), {
    var c = Module.canvas || document.getElementById('canvas');
    if (!c) return 0;
    // alpha:false lets the browser skip compositing against the page.
    var ctx = c.getContext('2d', { alpha: false });
    if (!ctx) return 0;
    ctx.imageSmoothingEnabled = false;
    Module._rt = { ctx: ctx, w: w, h: h, frames: 0, lastPresent: 0 };
    // Observable by tests: Module._rt.frames increments once per DG_DrawFrame.
    return 1;
});
EM_JS(void, rt_js_put, (const void *px, int w, int h), {
    var rt = Module._rt;
    if (!rt) return;
    // Rebuild the view every frame: ALLOW_MEMORY_GROWTH replaces the buffer.
    var data = new Uint8ClampedArray(HEAPU8.buffer, px, w * h * 4);
    rt.ctx.putImageData(new ImageData(data, w, h), 0, 0);
    rt.frames++;
    rt.lastPresent = performance.now();
});
EM_JS(void, rt_js_title, (const char *t), { document.title = UTF8ToString(t); });
void cap_render_init(void)
{
    frames_presented = 0;
    rt_js_init(CAP_FB_WIDTH, CAP_FB_HEIGHT);
}
void cap_render_present(const pixel_t *fb)
{
    const uint32_t *src = (const uint32_t *)fb;
    for (int i = 0; i < CAP_FB_WIDTH * CAP_FB_HEIGHT; i++) {
        uint32_t s = src[i];
        rgba[i] = 0xFF000000u | ((s & 0xFFu) << 16) | (s & 0xFF00u) | ((s >> 16) & 0xFFu);
    }
    rt_js_put(rgba, CAP_FB_WIDTH, CAP_FB_HEIGHT);
    frames_presented++;
}
uint32_t cap_time_ms(void)
{
    // Milliseconds since page start (monotonic). +1 keeps the first call
    // nonzero: i_timer.c treats basetime==0 as unset.
    return (uint32_t)emscripten_get_now() + 1;
}
// The engine only sleeps in 1 ms polls (wipe loop in d_main.c, tic wait in
// d_loop.c) and a 100 ms retry in d_loop.c. With ASYNCIFY, emscripten_sleep
// returns control to the event loop via setTimeout, so input, rAF and
// painting keep running while the engine waits and real time advances.
void cap_sleep_ms(uint32_t ms)
{
    emscripten_sleep(ms);
}
void cap_set_title(const char *title)
{
    rt_js_title(title);
}
uint32_t cap_render_frames(void)
{
    return frames_presented;
}
