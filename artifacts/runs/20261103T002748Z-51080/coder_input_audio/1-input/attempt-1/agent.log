    // Browser KeyboardEvent.code -> Doom key code (doomkeys.h).
    var KEYS = {
      ArrowLeft: 0xac, ArrowRight: 0xae, ArrowUp: 0xad, ArrowDown: 0xaf,
      ControlLeft: 0xa3, ControlRight: 0xa3, Space: 0xa2,
      ShiftLeft: 0xb6, ShiftRight: 0xb6, AltLeft: 0xb8, AltRight: 0xb8,
      Comma: 0xa0, Period: 0xa1, Enter: 13, NumpadEnter: 13, Escape: 27,
      Tab: 9, Backspace: 0x7f, Pause: 0xff, Minus: 0x2d, Equal: 0x3d,
      F1: 0xbb, F2: 0xbc, F3: 0xbd, F4: 0xbe, F5: 0xbf, F6: 0xc0,
      F7: 0xc1, F8: 0xc2, F9: 0xc3, F10: 0xc4, F11: 0xd7, F12: 0xd8
    };
    function doomKey(e) {
      if (KEYS[e.code]) return KEYS[e.code];
      var m = /^Key([A-Z])$/.exec(e.code);
      if (m) return m[1].toLowerCase().charCodeAt(0);
      m = /^Digit(\d)$/.exec(e.code);
      return m ? m[1].charCodeAt(0) : 0;
    }
    function send(pressed, e) {
      var k = doomKey(e);
      if (!k || !Module.calledRun) return;
      Module._cap_input_event(pressed, k);
      e.preventDefault();
    }
    window.addEventListener('keydown', function (e) { if (!e.repeat) send(1, e); else e.preventDefault(); });
    window.addEventListener('keyup', function (e) { send(0, e); });
    function release() { if (Module.calledRun) Module._cap_input_reset(); }
    window.addEventListener('blur', release);
    document.addEventListener('visibilitychange', function () { if (document.hidden) release(); });
    var Module = {
      canvas: document.getElementById('canvas'),
      print: function (t) { console.log(t); },
      printErr: function (t) { console.warn(t); }
    };
  </script>
  <script src="doom.js"></script>
</body>
</html>
