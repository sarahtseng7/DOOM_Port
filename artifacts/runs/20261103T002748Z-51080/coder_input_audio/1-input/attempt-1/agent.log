#define CAPSTONE_BRIDGE_H

#include <stdint.h>

#include "doomgeneric.h"

#ifdef __EMSCRIPTEN__
#include <emscripten.h>
#define CAP_EXPORT EMSCRIPTEN_KEEPALIVE
#else
#define CAP_EXPORT
#endif

#ifdef __cplusplus
